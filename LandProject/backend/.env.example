# LandSure BD - Environment Configuration (Development Demo)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT & Security
JWT_SECRET=demo_landsure_bd_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=24h

# Database (PostgreSQL Prisma connection string or SQLite local fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/landsure_bd?schema=public"

# Mock OTP Mode (Default true for hackathon / development)
MOCK_OTP_ENABLED=true
MOCK_OTP_DEFAULT_CODE=123456
OTP_EXPIRY_MINUTES=5

# SMS Gateway (For production deployment)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=LandSureBD
SMS_GATEWAY_URL=

# Storage Path for uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
